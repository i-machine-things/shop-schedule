SHOP_NAME="Your Shop Name"

# --- Active hours -----------------------------------------------------------
# update_schedule.py still runs every 15 minutes around the clock (cron/Task
# Scheduler), but only actually refreshes the display between these hours
# (device's own local time) -- nothing changes in JobBoss outside them, so
# there's nothing worth pulling. Default: 5am-5pm. Leave blank for either to
# use that default.
SCHEDULE_ACTIVE_START_HOUR=5
SCHEDULE_ACTIVE_END_HOUR=17

# --- JobBoss DB source (preferred) ---------------------------------------
# If JOBBOSS_DB_HOST/NAME/USER are all set, the schedule is pulled directly
# from JobBoss over the network and the PDF settings below are ignored.
# Use a SQL login with SELECT-only grants on Job, Job_Operation, and
# Work_Center -- nothing broader. See README.md for the login setup script.
#
# Use the exact "Server" value from your SQL Server ODBC DSN (Windows: ODBC
# Data Sources > System DSN > [your DSN] > Configure), e.g. a named instance
# like SMI-APP02\JBSQL. Leave JOBBOSS_DB_PORT blank in that case -- the port
# gets resolved automatically the same way the ODBC driver does it. Only set
# JOBBOSS_DB_PORT if that resolution isn't available and a DBA gave you a
# static port instead.
# If the value contains a backslash (named instance), wrap it in single
# quotes -- run_update.sh sources this file with bash, which otherwise
# silently strips the backslash: JOBBOSS_DB_HOST='SRV\INSTANCE'
JOBBOSS_DB_HOST=
JOBBOSS_DB_PORT=
JOBBOSS_DB_NAME=
JOBBOSS_DB_USER=
JOBBOSS_DB_PASS=
# Optional -- path to the JobBoss SQL Server's certificate (PEM/Base-64 .cer)
# to encrypt the DB connection. Without this, traffic (including job/customer
# data) is unencrypted. See README.md's "Known limitation" note for how to
# export the cert; leave blank if that's not available yet.
JOBBOSS_DB_CAFILE=

# --- PDF fallback (used only if JOBBOSS_DB_* is unset) -------------------
# Drop a PDF into incoming/ or upload one via options.html; see README.md.
# Company name exactly as it appears in the PDF header — used to skip that line during parsing.
PDF_COMPANY_NAME="Your Company Name"
# Filename for the saved Foreman's Report PDF (default: last_report.pdf).
# Set this to something specific so the script never accidentally parses a stray PDF.
PDF_FILENAME=foremans_report.pdf